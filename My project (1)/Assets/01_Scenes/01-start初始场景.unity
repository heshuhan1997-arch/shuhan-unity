  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "For over a thousand years, Jingdezhen has been famous for its porcelain,
    described as \u201Cwhite as jade, bright as a mirror, thin as paper, and clear
    as a chime.\u201D It is also known as a place where craftsmen came from everywhere,
    and porcelain was sent all over the world.\n\nThis digital museum follows the
    history of Jingdezhen and uses VR technology to show ceramic materials, production
    techniques, precious porcelain works, and the spirit of craftsmen."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
