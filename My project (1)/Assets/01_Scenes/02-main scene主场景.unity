  m_Script: {fileID: 11500000, guid: 183f05a31c807c2468e5998a7dcf056a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::J_Packages.itemModelInfo
  modelName: "\u73B2\u73D1\u74F6"
  modelDescription: "A fine example of Qing-dynasty famille rose porcelain from the
    Qianlong period. The surface is grounded with \u201Cglass white\u201D and delicately
    painted with softly shaded colors. Hundreds of butterflies appear in varied postures
    and vivid hues. The full, rounded form of the vase symbolizes \u201Chundreds
    of butterflies welcoming spring\u201D and wishes for lasting fortune and longevity,
    reflecting the elegance and refinement of imperial porcelain craftsmanship."
  modelAudio: {fileID: 8300000, guid: 2b36b5bb16beacb48b84c7a618f42179, type: 3}
